MONGODB_URI=mongodb://admin:admin@localhost:27017/ionutadrian91_backend?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_INITDB_DATABASE=ionutadrian91_backend
MONGODB_PORT=27017

NODE_ENV=development

PORT=5000
ENABLE_API_DOCS=true

JWT_SECRET=a-string-secret-at-least-256-bits-long
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Production Docker image used by docker-compose.prod.yaml.
DOCKER_IMAGE=fsdteamsaa/ionutadrian91-backend:latest
