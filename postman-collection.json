                                    "    pm.expect(jsonData).to.have.property('data');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": {
                            "raw": "{{base_url}}/user/{{user_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "user",
                                "{{user_id}}"
                            ]
                        },
                        "description": "Update a user by ID. Make sure 'user_id' variable is set."
