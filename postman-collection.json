                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": {
                            "raw": "{{base_url}}/user",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "user"
                            ]
                        },
                        "description": "Create a new user"
                    },
                    "response": []
